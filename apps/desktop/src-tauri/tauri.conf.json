{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alpemox",
  "version": "0.3.0",
  "identifier": "com.alpemox.studio",
  "build": {
    "beforeDevCommand": "npm --workspace=@opencraft/studio run dev",
    "devUrl": "http://127.0.0.1:5173/?page=launcher",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../studio/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Alpemox Creative Suite",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
